---
import Layout from '../../layouts/Layout.astro';

const GUIDES = [
  {
    slug: 'best-humidors-for-beginners',
    title: 'Best Humidors for Beginners',
    description: 'What to actually look for in your first humidor, and our current top pick.',
  },
  {
    slug: 'best-humidors-under-100',
    title: 'Best Humidors Under $100',
    description: 'What holds up at the sub-$100 price point, with confirmed current prices where checked.',
  },
  {
    slug: 'best-humidors-under-200',
    title: 'Best Humidors Under $200',
    description: 'What an extra $100 actually buys in a desktop humidor.',
  },
  {
    slug: 'desktop-vs-cabinet-vs-travel-humidors',
    title: 'Desktop vs Cabinet vs Travel Humidors Explained',
    description: 'What separates the three, and which one actually fits how you smoke.',
    evergreen: true,
  },
  {
    slug: 'best-torch-lighters',
    title: 'Best Torch Lighters',
    description: 'What separates a reliable torch lighter from a frustrating one.',
  },
  {
    slug: 'best-cigar-cutters',
    title: 'Best Cigar Cutters',
    description: 'Guillotine, V-cut, and punch cutters compared.',
  },
  {
    slug: 'guillotine-vs-v-cut-vs-punch',
    title: 'Guillotine vs V-Cut vs Punch: Which Cut and Why',
    description: 'The three main cigar cutting styles, and how to pick.',
    evergreen: true,
  },
  {
    slug: 'best-travel-cigar-cases',
    title: 'Best Travel Cigar Cases',
    description: 'Hard-shell vs. leather travel cases compared.',
  },
];
---

<Layout
  title="Buying Guides | StickScore"
  description="Humidor, lighter, and cutter buying guides — grounded in the same sourced, no-invented-scores rigor as the rest of the site."
>
  <div class="home-hero">
    <h1 class="home-hero__title">Guides</h1>
    <p>
      Practical buying guides for humidors, lighters, cutters, and travel cases — plus a few
      evergreen explainers on how the gear itself works.
    </p>
  </div>

  <section class="section">
    <div class="brand-directory">
      {GUIDES.map((g) => (
        <a class="cigar-card" href={`/guides/${g.slug}/`}>
          <div class="cigar-card__name">{g.title}</div>
          <div class="cigar-card__score">{g.description}</div>
        </a>
      ))}
    </div>
  </section>
</Layout>
