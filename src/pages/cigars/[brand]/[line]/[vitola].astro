---
import Layout from '../../../../layouts/Layout.astro';
import ScoreBar from '../../../../components/ScoreBar.astro';
import FtcDisclosure from '../../../../components/FtcDisclosure.astro';
import { getAllCigarSlugs, getCigarPage, getSimilarCigars } from '../../../../lib/db';
import type { CriticReviewRow } from '../../../../lib/db';

export function getStaticPaths() {
  return getAllCigarSlugs().map(({ brand, line, vitola }) => ({
    params: { brand, line, vitola },
  }));
}

const { brand: brandSlug, line: lineSlug, vitola: vitolaSlug } = Astro.params;
const data = getCigarPage(brandSlug as string, lineSlug as string, vitolaSlug as string);

if (!data) {
  return new Response(null, { status: 404 });
}

const { brand, line, vitola, criticReviews: allReviews } = data;

const professionalReviews = allReviews.filter((r) => r.source_type === 'critic');
const retailerRatings = allReviews.filter((r) => r.source_type === 'retailer');

// A few outlets share one editorial team under two names (e.g. Cigar Insider
// is Cigar Aficionado's own ratings newsletter) — canonicalized so the
// "independent sources" count isn't inflated by re-listing the same publisher.
const CANONICAL_SOURCE: Record<string, string> = {
  'Cigar Insider (Cigar Aficionado)': 'Cigar Aficionado',
  'Cigar Insider': 'Cigar Aficionado',
};
const canonSource = (name: string) => CANONICAL_SOURCE[name] ?? name;
const distinctSourceCount = new Set(allReviews.map((r) => canonSource(r.source_name))).size;

const tastingNotes: string[] = JSON.parse(vitola.tasting_notes);
const boxCounts: number[] = JSON.parse(vitola.box_counts);

// Flag a critic review as dissenting when it lands well below the group's
// average normalized score — surfaces disagreement instead of hiding it.
const normalized = professionalReviews.map((r) => ({ review: r, score: (r.score / r.score_scale) * 100 }));
const avgNormalized = normalized.reduce((sum, n) => sum + n.score, 0) / normalized.length;
const dissenting = normalized.filter((n) => avgNormalized - n.score >= 15);

function formatReviewDate(iso: string): string {
  return new Date(iso).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' });
}

const pageTitle = `${brand.name} ${line.name.replace(/ Maduro$| Natural$/, '')} ${vitola.size_name} Review & Rating | StickScore`;
const pageDescription = `${brand.name} ${vitola.size_name} (${vitola.length_in}x${vitola.ring_gauge}, ${line.wrapper} wrapper): StickScore ${vitola.stick_score ? Math.round(vitola.stick_score) : 'N/A'}/100 aggregated from ${professionalReviews.length} published reviews.`;

const similarCigars = getSimilarCigars(vitola.id, line.wrapper, line.strength);

const hasSubScores = [vitola.score_flavor, vitola.score_construction, vitola.score_complexity, vitola.score_value].some(
  (v) => v != null
);

// Per CLAUDE.md's StickScore rule: publish AggregateRating markup only once
// the 3-independent-source minimum is met (vitola.stick_score is already null
// otherwise, computed the same way in scripts/seed.mjs).
const totalReviewCount = professionalReviews.length + retailerRatings.length;
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Product',
  name: `${brand.name} ${line.name} ${vitola.size_name}`,
  brand: { '@type': 'Brand', name: brand.name },
  description: pageDescription,
  ...(vitola.stick_score != null
    ? {
        aggregateRating: {
          '@type': 'AggregateRating',
          ratingValue: Math.round(vitola.stick_score),
          bestRating: 100,
          worstRating: 0,
          reviewCount: totalReviewCount,
        },
      }
    : {}),
};
---

<Layout title={pageTitle} description={pageDescription}>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  <div class="cigar-hero">
    <a class="cigar-hero__eyebrow" href={`/brands/${brand.slug}/`}>{brand.name}</a>
    <h1 class="cigar-hero__title">{line.name.replace(/ Maduro$| Natural$/, '')} {vitola.size_name}</h1>
    <p class="cigar-hero__subtitle">
      {vitola.length_in}&Prime; &times; {vitola.ring_gauge} {vitola.vitola_type} &middot; {line.wrapper} wrapper &middot; {line.strength} strength
    </p>

    <div class="score-panel">
      <div class="score-panel__number">
        {vitola.stick_score != null ? Math.round(vitola.stick_score) : '—'}
        <small>StickScore</small>
      </div>
      <div>
        <div class="score-panel__label">
          {vitola.stick_score != null
            ? <>Aggregate of {professionalReviews.length} critic review{professionalReviews.length === 1 ? '' : 's'}
                {retailerRatings.length > 0 && ` and ${retailerRatings.length} retailer rating${retailerRatings.length === 1 ? '' : 's'}`}</>
            : <>Insufficient data — {distinctSourceCount} of the 3 independent sources StickScore requires</>}
        </div>
        <div class="score-panel__meta">
          {vitola.stick_score != null
            ? <>Critic reviews are weighted 70% and retailer ratings 30%{retailerRatings.length === 0 && ' (none collected yet for this cigar, so the figure above rests on critics alone)'}; reviews from the last five years count double. This is a computed aggregate, presented as such — never a first-hand StickScore review.</>
            : <>We don't publish a score until at least 3 independent outlets have rated a cigar — padding the average with fewer sources would overstate how settled the consensus really is. This one is in the review queue for follow-up.</>}
        </div>
      </div>
    </div>
  </div>

  {hasSubScores && (
    <section class="section">
      <h2 class="section__heading">Sub-scores</h2>
      <div class="score-bars">
        <ScoreBar label="Flavor" value={vitola.score_flavor} />
        <ScoreBar label="Construction" value={vitola.score_construction} />
        <ScoreBar label="Complexity" value={vitola.score_complexity} />
        <ScoreBar label="Value" value={vitola.score_value} />
      </div>
    </section>
  )}

  {tastingNotes.length > 0 && (
    <section class="section">
      <h2 class="section__heading">{distinctSourceCount >= 3 ? 'Consensus tasting notes' : 'Tasting notes (limited sources)'}</h2>
      <div class="tasting-tags">
        {tastingNotes.map((note) => <span class="tasting-tag">{note}</span>)}
      </div>
    </section>
  )}

  <section class="section summary-review">
    <h2 class="section__heading">Summary</h2>
    <p>{vitola.summary_review}</p>
  </section>

  {dissenting.length > 0 && (
    <section class="section">
      <h2 class="section__heading">Where critics disagree</h2>
      <div class="dissent-box">
        {dissenting.map((d) => (
          <p>
            <strong>{d.review.source_name}</strong> ({formatReviewDate(d.review.review_date)}) scored this
            notably lower than the group average — {d.review.key_notes_text}
          </p>
        ))}
      </div>
    </section>
  )}

  <section class="section">
    <h2 class="section__heading">Background</h2>
    <p>{line.background_text}</p>
    <p>{brand.story_short}</p>
  </section>

  <section class="section">
    <h2 class="section__heading">Specs</h2>
    <table class="specs-table">
      <tbody>
        <tr><th>Size</th><td>{vitola.size_name} ({vitola.vitola_type})</td></tr>
        <tr><th>Dimensions</th><td>{vitola.length_in}&Prime; &times; {vitola.ring_gauge} ring gauge</td></tr>
        <tr><th>Wrapper</th><td>{line.wrapper}</td></tr>
        <tr><th>Binder</th><td>{line.binder}</td></tr>
        <tr><th>Filler</th><td>{line.filler}</td></tr>
        <tr><th>Strength</th><td>{line.strength}</td></tr>
        <tr><th>Origin</th><td>{brand.country}</td></tr>
        <tr><th>Factory</th><td>{brand.factory}</td></tr>
        <tr><th>Release year</th><td>{line.release_year}</td></tr>
        {vitola.smoke_time_min && <tr><th>Typical smoke time</th><td>~{vitola.smoke_time_min} minutes</td></tr>}
        {boxCounts.length > 0 && <tr><th>Box sizes</th><td>{boxCounts.join(', ')}-count boxes</td></tr>}
      </tbody>
    </table>
  </section>

  <section class="section">
    <h2 class="section__heading">Pricing</h2>
    <FtcDisclosure hasAffiliateLinks={false} />
    <p class="placeholder-note">
      Retailer price tracking has not yet begun for this cigar — it starts with the nightly
      automation in a later phase. Rather than estimate, we simply show nothing until it's real.
    </p>
  </section>

  <section class="section">
    <h2 class="section__heading">Retailer ratings</h2>
    {retailerRatings.length > 0 ? (
      <div class="retailer-ratings">
        {retailerRatings.map((r: CriticReviewRow) => (
          <div class="retailer-rating">
            <a class="retailer-rating__name" href={r.url} target="_blank" rel="noopener noreferrer">{r.source_name}</a>
            <span class="retailer-rating__value">
              {r.score}/{r.score_scale}{r.review_count != null && ` · ${r.review_count} reviews`}
            </span>
          </div>
        ))}
      </div>
    ) : (
      <p class="placeholder-note">
        No retailer star ratings have been collected for this cigar yet. When they are, we'll
        show the aggregate rating and review count with a link back to the retailer — never
        copied review text.
      </p>
    )}
  </section>

  <section class="section">
    <h2 class="section__heading">Sources</h2>
    {professionalReviews.length > 0 ? (
      <ul class="sources-list">
        {professionalReviews.map((r: CriticReviewRow) => (
          <li>
            <a href={r.url} target="_blank" rel="noopener noreferrer">{r.source_name}</a>
            &nbsp;&middot;&nbsp;
            <span class="source-score">{r.score}/{r.score_scale}</span>
            &nbsp;&middot;&nbsp;
            {formatReviewDate(r.review_date)}
            {r.key_notes_text && <span class="source-notes">{r.key_notes_text}</span>}
          </li>
        ))}
      </ul>
    ) : (
      <p class="placeholder-note">
        No published critic reviews have been found yet for this exact vitola. It's in the
        review queue so future research passes can fill this in.
      </p>
    )}
  </section>

  <section class="section">
    <h2 class="section__heading">Similar cigars</h2>
    {similarCigars.length > 0 ? (
      <div class="search-results">
        {similarCigars.map((c) => (
          <a class="cigar-card" href={`/cigars/${c.brandSlug}/${c.lineSlug}/${c.vitolaSlug}/`}>
            <div class="cigar-card__brand">{c.brandName}</div>
            <div class="cigar-card__name">{c.lineName} {c.vitolaSizeName}</div>
            <div class="cigar-card__score">
              StickScore {c.stickScore != null ? Math.round(c.stickScore) : 'insufficient data'}
            </div>
          </a>
        ))}
      </div>
    ) : (
      <p class="placeholder-note">
        Nothing else in the catalog shares this wrapper or strength yet. As the catalog grows,
        a well-matched few will appear here.
      </p>
    )}
  </section>
</Layout>
