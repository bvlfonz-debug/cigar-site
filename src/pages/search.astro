---
import Layout from '../layouts/Layout.astro';
import { getSearchIndex } from '../lib/db';

const index = getSearchIndex();
---

<Layout
  title="Search Cigars | Cigar Codex"
  description="Filter the Cigar Codex catalog by wrapper, strength, country, and score."
>
  <div class="home-hero">
    <h1 class="home-hero__title">Search</h1>
    <p>
      Search by cigar, brand, or line name, or filter by wrapper, strength, country of origin, or
      minimum Codex Score. Price filtering will arrive once retailer price tracking begins.
    </p>
  </div>

  <section class="section">
    <div class="search-query-row">
      <input
        type="search"
        id="filter-query"
        placeholder="Type a cigar, brand, or line name…"
        aria-label="Search by name"
      />
    </div>

    <div class="search-filters">
      <label>
        Wrapper
        <select id="filter-wrapper"><option value="">All</option></select>
      </label>
      <label>
        Strength
        <select id="filter-strength"><option value="">All</option></select>
      </label>
      <label>
        Country
        <select id="filter-country"><option value="">All</option></select>
      </label>
      <label>
        Minimum Codex Score
        <select id="filter-score">
          <option value="0">Any</option>
          <option value="90">90+</option>
          <option value="80">80+</option>
          <option value="70">70+</option>
        </select>
      </label>
    </div>

    <div id="search-results" class="search-results"></div>
    <p id="search-empty" class="search-empty" hidden>
      No cigars found. If you searched by name, it may not be in the catalog yet — the catalog
      grows over time and doesn't cover every cigar in existence yet.
    </p>
  </section>
</Layout>

<script type="application/json" id="search-data" set:html={JSON.stringify(index)} />

<script>
  import { initHumidorButtons } from '../lib/humidor-client';

  interface Entry {
    brandName: string;
    brandSlug: string;
    lineName: string;
    lineSlug: string;
    vitolaSizeName: string;
    vitolaSlug: string;
    wrapper: string;
    strength: string;
    country: string;
    stickScore: number | null;
    path: string;
  }

  const dataEl = document.getElementById('search-data');
  const entries: Entry[] = dataEl ? JSON.parse(dataEl.textContent || '[]') : [];

  function populate(selectId: string, values: string[]) {
    const select = document.getElementById(selectId) as HTMLSelectElement | null;
    if (!select) return;
    const unique = Array.from(new Set(values)).sort();
    for (const v of unique) {
      const opt = document.createElement('option');
      opt.value = v;
      opt.textContent = v;
      select.appendChild(opt);
    }
  }

  populate('filter-wrapper', entries.map((e) => e.wrapper));
  populate('filter-strength', entries.map((e) => e.strength));
  populate('filter-country', entries.map((e) => e.country));

  const resultsEl = document.getElementById('search-results') as HTMLElement;
  const emptyEl = document.getElementById('search-empty') as HTMLElement;

  // Strips accents (Padrón -> Padron, Estelí -> Esteli) so a search typed on
  // a plain keyboard still matches — most smokers won't type the accent.
  function foldAccents(s: string): string {
    return s.normalize('NFD').replace(/[̀-ͯ]/g, '');
  }

  function render() {
    const query = foldAccents((document.getElementById('filter-query') as HTMLInputElement).value.trim().toLowerCase());
    const wrapper = (document.getElementById('filter-wrapper') as HTMLSelectElement).value;
    const strength = (document.getElementById('filter-strength') as HTMLSelectElement).value;
    const country = (document.getElementById('filter-country') as HTMLSelectElement).value;
    const minScore = Number((document.getElementById('filter-score') as HTMLSelectElement).value);

    const filtered = entries.filter((e) => {
      if (query) {
        const haystack = foldAccents(`${e.brandName} ${e.lineName} ${e.vitolaSizeName}`.toLowerCase());
        if (!haystack.includes(query)) return false;
      }
      if (wrapper && e.wrapper !== wrapper) return false;
      if (strength && e.strength !== strength) return false;
      if (country && e.country !== country) return false;
      if (minScore > 0 && (e.stickScore == null || e.stickScore < minScore)) return false;
      return true;
    });

    resultsEl.innerHTML = '';
    emptyEl.hidden = filtered.length > 0;

    for (const e of filtered) {
      const wrap = document.createElement('div');
      const a = document.createElement('a');
      a.className = 'cigar-card';
      a.href = e.path;
      a.innerHTML = `
        <div class="cigar-card__brand">${e.brandName}</div>
        <div class="cigar-card__name">${e.lineName} ${e.vitolaSizeName}</div>
        <div class="cigar-card__score">Codex Score ${e.stickScore != null ? Math.round(e.stickScore) : 'insufficient data'}</div>
      `;
      wrap.appendChild(a);
      // Mirrors src/components/HumidorButton.astro's exact markup — that
      // component only renders at build time, so result cards built here in
      // client JS replicate its structure directly (initHumidorButtons()'s
      // [data-humidor-button] selector doesn't care how the markup arrived).
      wrap.insertAdjacentHTML(
        'beforeend',
        `<div class="humidor-button" data-humidor-button data-cigar-id="${e.path}" data-humidor-source="search">
          <span class="humidor-button__status" data-humidor-status>Not in your humidor yet</span>
          <div class="humidor-button__actions">
            <button type="button" class="humidor-btn" data-humidor-action="want-to-try">Want to Try</button>
            <button type="button" class="humidor-btn" data-humidor-action="smoked">Mark as Smoked</button>
            <button type="button" class="humidor-btn humidor-btn--remove" data-humidor-action="remove" hidden>Remove</button>
          </div>
        </div>`
      );
      resultsEl.appendChild(wrap);
    }
    initHumidorButtons(resultsEl);
  }

  for (const id of ['filter-wrapper', 'filter-strength', 'filter-country', 'filter-score']) {
    document.getElementById(id)?.addEventListener('change', render);
  }
  document.getElementById('filter-query')?.addEventListener('input', render);

  // Pre-fill from ?q= so the header search box (which submits here as a plain
  // GET form) lands with results already filtered, no JS needed on other pages.
  const params = new URLSearchParams(window.location.search);
  const initialQuery = params.get('q');
  if (initialQuery) {
    (document.getElementById('filter-query') as HTMLInputElement).value = initialQuery;
  }

  render();
</script>
