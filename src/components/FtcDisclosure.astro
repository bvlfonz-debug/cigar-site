---
// Render only where affiliate links actually appear on the page — pass
// hasAffiliateLinks={true} from the caller. Keeping the gate in the caller
// (rather than always rendering) avoids disclosing links that don't exist yet.
//
// hasAmazonLinks appends Amazon's required verbatim disclosure sentence —
// per CLAUDE.md "Amazon Associates", this exact wording must appear on any
// page with an Amazon link.
interface Props {
  hasAffiliateLinks: boolean;
  hasAmazonLinks?: boolean;
}

const { hasAffiliateLinks, hasAmazonLinks = false } = Astro.props;
---

{hasAffiliateLinks && (
  <p class="ftc-disclosure">
    <strong>Disclosure:</strong> Some links below are affiliate links. If you buy through one,
    Cigar Codex may earn a commission at no extra cost to you — this never influences our scores
    or rankings.
    {hasAmazonLinks && ' As an Amazon Associate I earn from qualifying purchases.'}
  </p>
)}
