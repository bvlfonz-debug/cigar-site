---
// The Cigar Codex mark: a minimal engraved stone tablet with a carved "CC"
// monogram — deliberately archival/monumental rather than tobacco-themed
// (no leaves, smoke, or flame). Inline SVG so it stays crisp at any size
// and costs nothing to load.
interface Props {
  class?: string;
}
const { class: className } = Astro.props;
---

<svg
  class={className}
  viewBox="0 0 48 48"
  fill="none"
  xmlns="http://www.w3.org/2000/svg"
  role="img"
  aria-label="Cigar Codex mark"
>
  <rect x="4" y="3" width="40" height="42" rx="1.5" stroke="currentColor" stroke-width="1.5" />
  <rect x="7.5" y="6.5" width="33" height="35" rx="0.5" stroke="currentColor" stroke-width="0.75" opacity="0.55" />
  <line x1="24" y1="9" x2="24" y2="13" stroke="currentColor" stroke-width="1" opacity="0.7" />
  <line x1="24" y1="35" x2="24" y2="39" stroke="currentColor" stroke-width="1" opacity="0.7" />
  <text
    x="24"
    y="29"
    text-anchor="middle"
    font-family="'Cinzel Variable', Cambria, Georgia, serif"
    font-size="15"
    font-weight="600"
    letter-spacing="0.5"
    fill="currentColor"
  >CC</text>
</svg>
