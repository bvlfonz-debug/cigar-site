---
// Falls back to a typographic emblem — a carved specimen-label treatment
// (initial + dimensions + vitola shape) — when a line has no verified
// manufacturer photo yet. When `line.image_url` is set (only for images that
// passed manual visual verification against the actual product), renders
// that image instead with a source credit, same citation discipline as the
// rest of the site.
interface Props {
  brandInitial: string;
  vitolaType: string;
  lengthIn: number;
  ringGauge: number;
  imageUrl?: string | null;
  imageSourceName?: string | null;
  imageSourceUrl?: string | null;
}
const { brandInitial, vitolaType, lengthIn, ringGauge, imageUrl, imageSourceName, imageSourceUrl } = Astro.props;
---

{imageUrl ? (
  <div class="cigar-emblem cigar-emblem--photo">
    <div class="cigar-emblem__frame cigar-emblem__frame--photo">
      <img src={imageUrl} alt={`${vitolaType} cigar`} loading="lazy" />
    </div>
    {imageSourceName && (
      <p class="cigar-emblem__credit">
        Photo: {imageSourceUrl ? <a href={imageSourceUrl}>{imageSourceName}</a> : imageSourceName}
      </p>
    )}
  </div>
) : (
  <div class="cigar-emblem" aria-hidden="true">
    <div class="cigar-emblem__frame">
      <span class="cigar-emblem__initial">{brandInitial}</span>
      <span class="cigar-emblem__rule"></span>
      <span class="cigar-emblem__vitola">{vitolaType}</span>
      <span class="cigar-emblem__dims">{lengthIn}&Prime; &times; {ringGauge}</span>
    </div>
  </div>
)}
