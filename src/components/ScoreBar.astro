---
interface Props {
  label: string;
  value: number | null;
}

const { label, value } = Astro.props;
const pct = value != null ? Math.max(0, Math.min(100, value)) : 0;
---

<div class="score-bar">
  <span class="score-bar__label">{label}</span>
  <span class="score-bar__track"><span class="score-bar__fill" style={`width: ${pct}%`}></span></span>
  <span class="score-bar__value">{value != null ? Math.round(value) : '—'}</span>
</div>
