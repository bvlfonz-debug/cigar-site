---
import '../styles/global.css';
import AgeGate from '../components/AgeGate.astro';

interface Props {
  title: string;
  description: string;
  noindex?: boolean;
}

const { title, description, noindex = false } = Astro.props;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}
  </head>
  <body>
    <AgeGate />
    <header class="site-header">
      <div class="site-header__inner">
        <a class="site-header__brand" href="/">StickScore</a>
        <nav class="site-header__nav">
          <a href="/brands/">Brands</a>
          <a href="/factories/">Factories</a>
          <a href="/rankings/">Rankings</a>
          <a href="/deals/">Deals</a>
          <a href="/news/">News</a>
          <a href="/calendar/">Calendar</a>
          <a href="/accessories/">Accessories</a>
          <a href="/guides/">Guides</a>
          <a href="/pairings/">Pairings</a>
          <a href="/lounges/">Lounges</a>
          <a href="/humidor/">My Humidor</a>
        </nav>
        <form class="site-header__search" action="/search/" method="get">
          <input type="search" name="q" placeholder="Search cigars…" aria-label="Search cigars by name" />
          <button type="submit">Search</button>
        </form>
        <span class="site-header__tagline">A Considered Record for the Discerning Smoker</span>
      </div>
    </header>
    <main>
      <slot />
    </main>
    <footer class="site-footer">
      <div class="site-footer__inner">
        StickScore weighs published critic reviews and retailer ratings into a single,
        comparable figure per cigar. We do not sell cigars directly, and we do not present
        this aggregate as a first-hand account — every source is cited in full on its page.
      </div>
    </footer>
  </body>
</html>

<script>
  // Site-wide: activates every <HumidorButton> instance on whatever page
  // rendered one (cigar pages, the comparison tool, search results) — see
  // src/lib/humidor-client.ts and CLAUDE.md "Personal Humidor". A no-op on
  // pages with no humidor-button markup.
  import { initHumidorButtons } from '../lib/humidor-client';
  initHumidorButtons();
</script>
